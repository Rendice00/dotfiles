set number
set relativenumber
set mouse=a
set ttimeoutlen=10

filetype plugin indent on
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4
set smartindent
set clipboard=unnamedplus
set hlsearch
set incsearch
set ignorecase
set smartcase
set completeopt=menu,menuone,noselect,noinsert
set signcolumn=yes
syntax on
